 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        @page {\n            size: A4;\n            margin: 10mm;\n        }\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 20px;\n        }\n        .label-container {\n            width: 100%;\n            border-collapse: collapse;\n            border: 3px solid black;\n        }\n        .label-container td {\n            border: 2px solid black;\n            padding: 8px;\n            font-size: 14pt;\n        }\n        .header-row {\n            font-weight: bold;\n            text-align: left;\n            background-color: #f0f0f0;\n        }\n        .value-row {\n            text-align: left;\n        }\n        .variety-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 10px;\n        }\n        .variety-table th {\n            border: 2px solid black;\n            padding: 5px;\n            font-weight: bold;\n            font-size: 13pt;\n            text-align: center;\n            background-color: #f0f0f0;\n        }\n        .variety-table td {\n            border: 2px solid black;\n            padding: 5px;\n            font-size: 13pt;\n            text-align: center;\n        }\n        .footer-section {\n            margin-top: 20px;\n        }\n        .footer-table {\n            width: 100%;\n            border-collapse: collapse;\n            border: 3px solid black;\n        }\n        .footer-table td {\n            border: 2px solid black;\n            padding: 15px;\n            font-size: 16pt;\n            font-weight: bold;\n            text-align: center;\n        }\n        /* The team / box-count line only has to hold one short line of text,\n           but it inherited the 15px all-round padding of every footer cell,\n           which made it nearly as tall as the barcode block. Tighten the\n           padding and the line box instead of shrinking the type -- the box\n           count has to stay readable across a packhouse. */\n        .footer-table td.footer-head {\n            padding: 2px 10px;\n            line-height: 1;\n        }\n        /* QR is square -- unlike the old Code 128 strip, stretching it to\n           the full label width would either distort it or waste most of\n           that width as blank margin. Split the row instead: a fixed-size\n           square QR cell alongside a second cell that uses the freed-up\n           width for the id in large, easy-to-read text (a human backup\n           when a scanner can't get a clean read). */\n        .footer-table td.qr-cell {\n            width: 38mm;\n            padding: 4px;\n        }\n        .qr-cell img {\n            display: block;\n            width: 32mm;\n            height: 32mm;\n            margin: 0 auto;\n        }\n        .footer-table td.qr-id-cell {\n            font-family: \"Courier New\", monospace;\n            font-size: 15pt;\n            letter-spacing: 1px;\n            word-break: break-all;\n        }\n    </style>\n</head>\n<body>\n    <!-- Main Label Table -->\n    <table class=\"label-container\">\n        <!-- Farm Code Row -->\n        <tr>\n            <td class=\"header-row\" style=\"width: 30%;\">FARM CODE</td>\n            <td class=\"value-row\" colspan=\"2\">{{ doc.farm_code }}</td>\n            <td class=\"value-row\" style=\"width: 20%; font-weight: bold;\">TRUCK</td>\n        </tr>\n        \n        <!-- Customer Row -->\n        <tr>\n            <td class=\"header-row\">CUSTOMER</td>\n            <td class=\"value-row\" colspan=\"2\">{{ doc.customer }}</td>\n            <td class=\"value-row\" rowspan=\"3\" style=\"font-size: 18pt; vertical-align: middle;\">\n                {{ doc.truck_details or \"BEST FLORA\" }}\n            </td>\n        </tr>\n        \n        <!-- Order Name Row -->\n        <tr>\n            <td class=\"header-row\">ORDER NAME</td>\n            <td class=\"value-row\" colspan=\"2\">\n                {% if doc.order_pick_list %}\n                    {% set opl = frappe.get_doc(\"Order Pick List\", doc.order_pick_list) %}\n                    {% if opl.sales_order %}\n                        {% set so = frappe.get_doc(\"Sales Order\", opl.sales_order) %}\n                        {{ so.custom_order_name or \"-\" }}\n                    {% else %}\n                        -\n                    {% endif %}\n                {% else %}\n                    -\n                {% endif %}\n            </td>\n        </tr>\n\n        <!-- Freight Agent Row -->\n        <tr>\n            <td class=\"header-row\">FREIGHT AGENT</td>\n            <td class=\"value-row\" colspan=\"2\">\n                {% if doc.freight_agent %}\n                    {{ doc.freight_agent }}\n                {% else %}\n                    {{ doc.truck_details or \"-\" }}\n                {% endif %}\n            </td>\n        </tr>\n        \n        <!-- Drop Off Point Row -->\n        <tr>\n            <td class=\"header-row\">DROP OFF POINT</td>\n            <td class=\"value-row\" colspan=\"3\">{{ doc.delivery_point or \"-\" }}</td>\n        </tr>\n    </table>\n\n    <!-- Variety Table -->\n    <table class=\"variety-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 50%;\">VARIETY</th>\n                <th style=\"width: 25%;\">LENGTH</th>\n                <th style=\"width: 25%;\">STEMS</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.box_item %}\n            <tr>\n                <td style=\"text-align: left; padding-left: 10px;\">{{ item.variety }}</td>\n                <td>{{ item.length or \"-\" }}</td>\n                <td>\n                    {% set uom_str = item.uom | string %}\n                    {% set start_pos = uom_str.find('(') %}\n                    {% set end_pos = uom_str.find(')') %}\n                    {% if start_pos != -1 and end_pos != -1 %}\n                        {% set uom_number = uom_str[start_pos+1:end_pos] | int %}\n                    {% else %}\n                        {% set uom_number = 1 %}\n                    {% endif %}\n                    {{ (item.qty * uom_number) | int }}\n                </td>\n            </tr>\n            {% endfor %}\n            \n            <!-- Pack Rate Row -->\n            <tr style=\"background-color: #f0f0f0;\">\n                <td style=\"text-align: left; padding-left: 10px; font-weight: bold;\">PACK RATE</td>\n                <td colspan=\"2\" style=\"font-weight: bold;\">{{ doc.pack_rate | int }}</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <!-- Footer Section -->\n    <div class=\"footer-section\">\n        <table class=\"footer-table\">\n            <tr>\n                <td class=\"footer-head\" style=\"width: 50%;\">\n                    <span style=\"font-size: 16pt;\">\n                        {% if doc.order_pick_list %}\n                            {% set opl = frappe.get_doc(\"Order Pick List\", doc.order_pick_list) %}\n                            {# The field on Order Pick List is `team`; `custom_team`\n                               never existed there, which is why this cell always\n                               printed \"-\". #}\n                            {{ opl.team or opl.custom_team or \"-\" }}\n                        {% else %}\n                            -\n                        {% endif %}\n                    </span>\n                </td>\n                <td class=\"footer-head\" style=\"width: 50%; font-size: 18pt;\">\n                    {{ doc.box_number }} OF {{ doc.box_total_count }}\n                </td>\n            </tr>\n            {% if doc.barcode %}\n            {# QR of this Box Label's own id -- {\"box_label\": \"<id>\"}, the exact\n               payload staging/loading/dispatch already scan (same convention as\n               every other scannable code in this system: bucket, bunch, shelf).\n               Square code gets its own fixed-size cell; the id repeats as real\n               text in the cell beside it, using the width a wide barcode strip\n               used to need, as a human-readable backup when a scan misses. #}\n            <tr>\n                <td class=\"qr-cell\">\n                    <img src=\"{{ doc.barcode }}\" alt=\"{{ doc.name }}\">\n                </td>\n                <td class=\"qr-id-cell\">{{ doc.name }}</td>\n            </tr>\n            {% endif %}\n        </table>\n    </div>\n</body>\n</html>",
