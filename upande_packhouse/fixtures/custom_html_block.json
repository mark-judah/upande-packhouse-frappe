  "html": "<div class=\"phn\">\n  <div class=\"phn-hero\"><div class=\"phn-hero-tt\">Roses Packhouse</div><div class=\"phn-hero-sub\">eSales &middot; order to dispatch</div></div>\n  <div class=\"phn-title\">Orders</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/sales-order/new\">\n      <span class=\"phn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"15\"/><line x1=\"9\" y1=\"12\" x2=\"15\" y2=\"12\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Enter Order</span><span class=\"phn-sub\">New sales order</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/sales-order\">\n      <span class=\"phn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 6h15l-1.5 9h-12z\"/><circle cx=\"9\" cy=\"20\" r=\"1\"/><circle cx=\"18\" cy=\"20\" r=\"1\"/><path d=\"M6 6 5 3H2\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Sales Orders</span><span class=\"phn-sub\">Enter & track orders</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/specifications\">\n      <span class=\"phn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"9\" y1=\"13\" x2=\"15\" y2=\"13\"/><line x1=\"9\" y1=\"17\" x2=\"13\" y2=\"17\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Specifications</span><span class=\"phn-sub\">Order spec templates</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Allocation & Stock</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/sales-allocation\">\n      <span class=\"phn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Sales Allocation</span><span class=\"phn-sub\">Allocate boxes & bunches</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/bucket-allocation-status\">\n      <span class=\"phn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16l-1.5 13a2 2 0 0 1-2 1.8H7.5a2 2 0 0 1-2-1.8z\"/><path d=\"M3 6h18\"/><path d=\"M9 3h6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Bucket Allocations</span><span class=\"phn-sub\">Monitor allocations</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/shelf\">\n      <span class=\"phn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"1\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/><line x1=\"3\" y1=\"15\" x2=\"21\" y2=\"15\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Shelf Stock</span><span class=\"phn-sub\">Available graded stock</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/discard-request\">\n      <span class=\"phn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 6 5 6 21 6\"/><path d=\"M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6\"/><path d=\"M10 11v6M14 11v6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Discards</span><span class=\"phn-sub\">Discard requests</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Picking & Packing</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/order-pick-list\">\n      <span class=\"phn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><circle cx=\"3.5\" cy=\"6\" r=\"1\"/><circle cx=\"3.5\" cy=\"12\" r=\"1\"/><circle cx=\"3.5\" cy=\"18\" r=\"1\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Order Pick Lists</span><span class=\"phn-sub\">Monitor OPLs</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/farm-pack-list\">\n      <span class=\"phn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8l-9-5-9 5 9 5 9-5z\"/><path d=\"M3 8v8l9 5 9-5V8\"/><path d=\"M12 13v8\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Farm Pack Lists</span><span class=\"phn-sub\">Monitor packing</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/packing-teams\">\n      <span class=\"phn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M2 20c0-3.5 3-6 7-6s7 2.5 7 6\"/><path d=\"M17 8a3 3 0 0 1 0 6\"/><path d=\"M22 20c0-2.5-1.5-4.5-4-5.5\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Packing Teams</span><span class=\"phn-sub\">Teams & packrates</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Labels</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/box-label\">\n      <span class=\"phn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.6 13.4 12 22l-9-9V3h10z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1.5\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Box Labels</span><span class=\"phn-sub\">Monitor box labels</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/label-print\">\n      <span class=\"phn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 6 2 18 2 18 9\"/><rect x=\"4\" y=\"9\" width=\"16\" height=\"8\" rx=\"2\"/><rect x=\"7\" y=\"15\" width=\"10\" height=\"6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Label Print</span><span class=\"phn-sub\">Print QR labels</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Logistics & Dispatch</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/loading-plan\">\n      <span class=\"phn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"6\" width=\"13\" height=\"10\"/><path d=\"M14 9h4l3 3v4h-7z\"/><circle cx=\"5.5\" cy=\"18\" r=\"1.6\"/><circle cx=\"17.5\" cy=\"18\" r=\"1.6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Loading Plans</span><span class=\"phn-sub\">Plan trucks</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/loading-sheet\">\n      <span class=\"phn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"19\" r=\"2\"/><circle cx=\"18\" cy=\"5\" r=\"2\"/><path d=\"M6 17V9a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v0\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Loading Sheets</span><span class=\"phn-sub\">Plan trips / loading</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/delivery-note\">\n      <span class=\"phn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h13v10H3z\"/><path d=\"M16 10h3l2 2v5h-5z\"/><path d=\"M3 7 5 3h9l2 4\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Delivery Notes</span><span class=\"phn-sub\">Monitor dispatch</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/dispatch-form\">\n      <span class=\"phn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"6\" height=\"6\"/><rect x=\"15\" y=\"15\" width=\"6\" height=\"6\"/><path d=\"M9 6h6a3 3 0 0 1 3 3v6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Dispatch Forms</span><span class=\"phn-sub\">Dispatch records</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/sales-invoice\">\n      <span class=\"phn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 2h9l5 5v15H6z\"/><path d=\"M14 2v6h6\"/><line x1=\"9\" y1=\"13\" x2=\"16\" y2=\"13\"/><line x1=\"9\" y1=\"17\" x2=\"16\" y2=\"17\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Sales Invoices</span><span class=\"phn-sub\">Monitor invoices</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Production (upstream)</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/shelving-log\">\n      <span class=\"phn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16v16H4z\"/><line x1=\"8\" y1=\"8\" x2=\"16\" y2=\"8\"/><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"/><line x1=\"8\" y1=\"16\" x2=\"12\" y2=\"16\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Shelving Log</span><span class=\"phn-sub\">Harvest → shelf events</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"\" href=\"/app/stock-entry\">\n      <span class=\"phn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"6\" height=\"6\"/><rect x=\"15\" y=\"15\" width=\"6\" height=\"6\"/><path d=\"M9 6h6a3 3 0 0 1 3 3v6\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Stock Entries</span><span class=\"phn-sub\">Harvest / receive / grade</span></span>\n    </a>\n  </div>\n  <div class=\"phn-title\">Masters & Setup</div>\n  <div class=\"phn-grid\">\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/consignee\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-7 8-7s8 3 8 7\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Consignees</span><span class=\"phn-sub\">Buyers / consignees</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/delivery-point\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Delivery Points</span><span class=\"phn-sub\">Destinations</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/shipping-agent\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 14l9-4 9 4-2 6H5z\"/><path d=\"M12 10V4M8 6h8\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Shipping Agents</span><span class=\"phn-sub\">Freight agents</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/packrate\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"9\" x2=\"20\" y2=\"9\"/><line x1=\"4\" y1=\"15\" x2=\"20\" y2=\"15\"/><line x1=\"10\" y1=\"3\" x2=\"8\" y2=\"21\"/><line x1=\"16\" y1=\"3\" x2=\"14\" y2=\"21\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Packrates</span><span class=\"phn-sub\">Stems per box</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/stem-length\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"8\" width=\"20\" height=\"8\" rx=\"1\"/><line x1=\"7\" y1=\"8\" x2=\"7\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"17\" y1=\"8\" x2=\"17\" y2=\"12\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Stem Lengths</span><span class=\"phn-sub\">Length masters</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/colors\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"8\" cy=\"9\" r=\"1\"/><circle cx=\"12\" cy=\"7.5\" r=\"1\"/><circle cx=\"16\" cy=\"9\" r=\"1\"/><circle cx=\"16.5\" cy=\"13\" r=\"1\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">Colors</span><span class=\"phn-sub\">Colour masters</span></span>\n    </a>\n    <a class=\"phn-tile\" data-roles=\"System Manager,Sales Manager\" href=\"/app/so-warehouse-mapping\">\n      <span class=\"phn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 3 3 5v16l6-2 6 2 6-2V3l-6 2z\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"19\"/><line x1=\"15\" y1=\"5\" x2=\"15\" y2=\"21\"/></svg></span>\n      <span class=\"phn-tx\"><span class=\"phn-lb\">SO Warehouse Mapping</span><span class=\"phn-sub\">Source → delivery WH</span></span>\n    </a>\n  </div>\n</div>",
  "modified": "2026-08-16 12:35:51.984217",
  "name": "Packhouse Navigation",
  "private": 0,
  "roles": [],
  "script": "(function() {\n  try {\n    if (!document.querySelector('link[data-phn-poppins]')) {\n      var pf=document.createElement('link'); pf.rel='stylesheet'; pf.setAttribute('data-phn-poppins','1');\n      pf.href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch(e){}\n\n  // Role-gate tiles: data-roles=\"\" shows for everyone; otherwise only if the\n  // user holds one of the listed roles. System Manager / Administrator see all.\n  var roles = (window.frappe && frappe.user_roles) || [];\n  var isAdmin = roles.indexOf('System Manager') >= 0\n    || roles.indexOf('Administrator') >= 0\n    || (window.frappe && frappe.user && frappe.user.name === 'Administrator');\n  root_element.querySelectorAll('.phn-tile').forEach(function(tile) {\n    var req = (tile.getAttribute('data-roles') || '')\n      .split(',').map(function(s){return s.trim();}).filter(Boolean);\n    if (req.length === 0) return;\n    var ok = isAdmin || req.some(function(r){ return roles.indexOf(r) >= 0; });\n    if (!ok) tile.classList.add('phn-hide');\n  });\n\n  // Hide a section title if every tile under it is hidden.\n  root_element.querySelectorAll('.phn-title').forEach(function(t){\n    var grid = t.nextElementSibling;\n    if (!grid || !grid.classList.contains('phn-grid')) return;\n    var vis = grid.querySelectorAll('.phn-tile:not(.phn-hide)').length;\n    if (!vis) { t.classList.add('phn-hide'); grid.classList.add('phn-hide'); }\n  });\n})();",
  "style": ".phn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.phn-hero{margin:0 0 16px 2px;}\n.phn-hero-tt{font-size:20px;font-weight:700;line-height:1.1;color:var(--heading-color,#1c1c1c);}\n.phn-hero-sub{font-size:12px;color:#8a8f98;margin-top:3px;letter-spacing:.02em;}\n.phn-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:18px 0 10px 2px;}\n.phn-title:first-of-type{margin-top:0;}\n.phn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;}\n.phn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease,border-color .18s ease;}\n.phn-tile:hover{box-shadow:0 2px 8px rgba(0,0,0,.07);transform:translateY(-1px);border-color:var(--gray-300,#c9ced6);text-decoration:none;}\n.phn-tile:hover .phn-lb,.phn-tile:hover .phn-sub{text-decoration:none;}\n.phn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.phn-ic svg{width:18px;height:18px;}\n.phn-tx{min-width:0;display:flex;flex-direction:column;}\n.phn-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.phn-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}\n.phn-hide{display:none !important;}"
 }
]