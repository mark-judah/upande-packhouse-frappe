[
 {
  "doctype": "Email Template",
  "name": "Standing Order Reminder",
  "subject": "Process the standing order for {{ doc.customer_name }} \u00b7 delivery {{ standing_summary(doc).delivers }}",
  "use_html": 1,
  "response": "",
  "response_html": "{% set s = standing_summary(doc) %}<div style=\"margin:0;padding:32px 16px;background:#f4f3ef;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#0a0a0a;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;border-collapse:separate;\">\n<tr><td style=\"padding:0 4px 16px 4px;font-size:11px;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;color:#8a8780;\">Packhouse &middot; Standing orders</td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e8e6df;border-radius:20px;padding:32px;\">\n  <div style=\"font-size:22px;line-height:1.3;font-weight:600;color:#0a0a0a;margin:0 0 6px 0;\">A standing order is ready to process</div>\n  <div style=\"font-size:14px;line-height:1.6;color:#5a5a52;margin:0 0 24px 0;\">{{ doc.customer_name }}&rsquo;s order was created today. It is a draft, so it will not be packed until it is checked and submitted.</div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:separate;border-spacing:0;margin:0 0 24px 0;background:#fafaf6;border-radius:14px;\">\n    <tr>\n      <td width=\"33%\" style=\"padding:16px 8px 16px 20px;\"><div style=\"font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#8a8780;\">Boxes</div><div style=\"font-size:24px;font-weight:600;color:#0a0a0a;line-height:1.2;\">{{ \"{:,}\".format(s.boxes|int) }}</div></td>\n      <td width=\"33%\" style=\"padding:16px 8px;\"><div style=\"font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#8a8780;\">Stems</div><div style=\"font-size:24px;font-weight:600;color:#0a0a0a;line-height:1.2;\">{{ \"{:,}\".format(s.stems|int) }}</div></td>\n      <td width=\"34%\" style=\"padding:16px 20px 16px 8px;\"><div style=\"font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#8a8780;\">Lines</div><div style=\"font-size:24px;font-weight:600;color:#0a0a0a;line-height:1.2;\">{{ s.lines }}</div></td>\n    </tr>\n  </table>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:14px;margin:0 0 28px 0;\">\n    <tr><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#8a8780;width:42%;\">Order</td><td style=\"padding:12px 0;border-top:1px solid #efede6;font-weight:600;color:#0a0a0a;\">{{ doc.name }}</td></tr>\n    <tr><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#8a8780;\">Customer</td><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#0a0a0a;\">{{ doc.customer_name }}</td></tr>\n    {% if doc.po_no %}<tr><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#8a8780;\">PO</td><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#0a0a0a;\">{{ doc.po_no }}</td></tr>{% endif %}\n    {% if doc.custom_consignee %}<tr><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#8a8780;\">Consignee</td><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#0a0a0a;\">{{ doc.custom_consignee }}</td></tr>{% endif %}\n    <tr><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#8a8780;\">Appeared</td><td style=\"padding:12px 0;border-top:1px solid #efede6;color:#0a0a0a;\">{{ s.appears }}</td></tr>\n    <tr><td style=\"padding:12px 0;border-top:1px solid #efede6;border-bottom:1px solid #efede6;color:#8a8780;\">Delivery</td><td style=\"padding:12px 0;border-top:1px solid #efede6;border-bottom:1px solid #efede6;\"><span style=\"display:inline-block;background:rgba(34,136,131,0.12);color:#228883;font-weight:600;border-radius:999px;padding:4px 12px;\">{{ s.delivers }}</span>{% if s.days_after %} <span style=\"color:#8a8780;font-size:13px;\">&nbsp;{{ s.days_after }} day{{ \"\" if s.days_after == 1 else \"s\" }} after it appeared</span>{% endif %}</td></tr>\n  </table>\n\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background:#0a0a0a;border-radius:999px;\"><a href=\"{{ s.order_url }}\" style=\"display:inline-block;padding:13px 28px;font-size:14px;font-weight:500;color:#fafaf6;text-decoration:none;\">Open the order</a></td></tr></table>\n</td></tr>\n<tr><td style=\"padding:18px 8px 0 8px;font-size:12px;line-height:1.7;color:#8a8780;\">\n  Repeats {{ s.frequency|lower }}.{% if s.next_appears %} Next order appears {{ s.next_appears }} and is delivered {{ s.next_delivers }}.{% endif %}<br>\n  Sent by the standing order {{ s.auto_repeat }}. To change when it repeats or who gets this email, open Standing orders in the packhouse Sales Order page.\n</td></tr>\n</table>\n</div>"
 }
]